          {
            "@id": "https://oleskostudio.com/de-at#faq",
            "@type": "FAQPage",
            "inLanguage": "de-AT",
            "mainEntity": [
              {
                "@type": "Question",
                "name": "KANN ICH DAS SELBST MIT KI-SOFTWARE MACHEN?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Ja. Jeder kann das, wenn er das Können hat und die Werkzeuge beherrscht. Die Software ist nicht der Auftrag. Der Auftrag ist das Wissen, wie ein echtes Automobil in Bewegung aussieht, und die Arbeit, es dorthin zu bringen."
                }
              },
              {
                "@type": "Question",
                "name": "GEHT DAS, WENN DER HERSTELLER NUR OFFIZIELLES MARKENMATERIAL ERLAUBT?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Das ist keine Herstellerwerbung. Es ist ein beauftragter Film eines bestimmten Automobils, aus Ihren Fotografien, ohne Anspruch auf Markengenehmigung. Verbietet ein Händlervertrag tatsächlich inoffizielle Filme auf neuem Bestand, ist das Ihre Grenze. Für Ihr eigenes Auto, Inserat oder Ihren Kunden gilt das nicht in derselben Weise."
                }
              },
              {
                "@type": "Question",
                "name": "WAS IST EIN AUTOMOBILFILM AUF AUFTRAG?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Ihr beauftragter Film ist eine kurze visuelle Arbeit aus gelieferten Fotografien. Er kann Ihr Automobil in eine komponierte Geschichte, einen Ort oder eine Atmosphäre setzen, ohne einen konventionellen Location-Dreh."
                }
              },
              {
                "@type": "Question",
                "name": "WAS MUSS ICH LIEFERN?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Klare Fotografien aus brauchbaren Winkeln, wichtige Erscheinungsdetails und eine kurze Beschreibung des Ergebnisses, das Sie wollen."
                }
              },
              {
                "@type": "Question",
                "name": "MUSS MEIN AUTOMOBIL TRANSPORTIERT WERDEN?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Nein. Ihr Film entsteht aus gelieferten Fotografien."
                }
              },
              {
                "@type": "Question",
                "name": "BRAUCHT MEIN FILM EIN KOMMERZIELLES ZIEL?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Nein. Ihr Film kann ein kommerzielles Ziel stützen, oder für persönliche Bedeutung und Emotion entstehen."
                }
              },
              {
                "@type": "Question",
                "name": "WIE LANGE DAUERT MEIN FILM?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Ein üblicher Auftrag wird in einer Woche geliefert."
                }
              },
              {
                "@type": "Question",
                "name": "WERDEN MEINE MARKENRICHTLINIEN BEACHTET?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Ja. Gelieferte Richtlinien und Kommunikationsvorgaben gehen in Ihr Briefing ein."
                }
              },
              {
                "@type": "Question",
                "name": "SIND DIE BILDER ECHT ODER ERZEUGT?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Ihr Film verwendet komponierte Bilder und moderne Bildtechnik, die generative KI einschließen kann, in einem persönlich verantworteten Herstellungsprozess. Die Art der Bilder wird klar benannt."
                }
              },
              {
                "@type": "Question",
                "name": "KANN MEIN FILM EINEN ECHTEN SHOWROOM, EINE VILLA ODER EINE ERKENNBARE PERSON ZEIGEN?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Ja. Eigene reale Orte und erkennbare Personen können als zusätzliche Anforderungen beauftragt werden, wenn geeignetes Referenzmaterial vorliegt."
                }
              },
              {
                "@type": "Question",
                "name": "KANN ICH KENNZEICHEN, BRANDING UND AUSLIEFERUNGSFORMAT VORGEBEN?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Ja. Kennzeichen, Abschlussbranding, Seitenverhältnis und Auflösung können Teil Ihres Auftrags sein; manche Wahl kann den Preis ändern."
                }
              },
              {
                "@type": "Question",
                "name": "WELCHE NUTZUNGSRECHTE SIND ENTHALTEN?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Zulässige Nutzungen sind für jeden Auftrag klar bestimmt. Ihre Vereinbarung legt Lieferung, Nutzung und etwaige Grenzen fest, bevor die Herstellung beginnt."
                }
              },
              {
                "@type": "Question",
                "name": "WIRD MEIN AUFTRAGSFILM VERÖFFENTLICHT?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Nur mit Ihrer gesonderten Zustimmung. Veröffentlichung in der Kollektion, in den sozialen Medien, Tags und Inseratslinks brauchen jeweils eigene Einwilligung."
                }
              }
            ]
          }
        ]
